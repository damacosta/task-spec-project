{
    "name": "@he4rt/sycorax",
    "license": "MIT",
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.4.2",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"**/*.{js,ts,json,yml,md,css}\"",
        "prepare": "husky",
        "outdated": "npm-check-updates"
    },
    "devDependencies": {
        "@inertiajs/react": "^3.7",
        "@inertiajs/vite": "^3.7",
        "@mdx-js/react": "^3.1",
        "@mdx-js/rollup": "^3.1",
        "@mintlify/components": "^1.0.19",
        "@tailwindcss/typography": "0.5.20",
        "@tailwindcss/vite": "4.3.3",
        "@vitejs/plugin-react": "^6.1",
        "autoprefixer": "10.6.1",
        "concurrently": "10.0.5",
        "fontaine": "0.8.2",
        "husky": "9.1.7",
        "laravel-vite-plugin": "3.2.0",
        "lint-staged": "17.5.1",
        "lucide-react": "^1.47.0",
        "npm-check-updates": "23.1.0",
        "prettier": "3.9.8",
        "react": "^19.3",
        "react-dom": "^19.3",
        "rehype-slug": "^6",
        "remark-frontmatter": "^5",
        "remark-gfm": "^4",
        "remark-mdx-frontmatter": "^5.2",
        "tailwindcss": "4.3.3",
        "unist-util-visit": "^5",
        "vite": "8.3.0"
    },
    "lint-staged": {
        "*.{js,ts,json,yml,md,css}": [
            "prettier --write"
        ],
        "*.php": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ]
    }
}
