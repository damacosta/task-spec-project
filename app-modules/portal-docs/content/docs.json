{
    "$schema": "https://mintlify.com/docs.json",
    "name": "Sycorax",
    "description": "Documentação da plataforma Sycorax e da sua API.",
    "colors": {
        "primary": "#7C3AED",
        "light": "#A78BFA",
        "dark": "#5B21B6"
    },
    "appearance": {
        "default": "system"
    },
    "contextual": {
        "options": ["copy", "view", "chatgpt", "claude"]
    },
    "navigation": {
        "tabs": [
            {
                "tab": "Documentation",
                "groups": [
                    {
                        "group": "Começar",
                        "pages": ["get-started"]
                    },
                    {
                        "group": "Conceitos",
                        "pages": ["concepts/arquitetura"]
                    },
                    {
                        "group": "Fluxos",
                        "pages": ["flows/documentar-um-endpoint"]
                    },
                    {
                        "group": "Referência",
                        "pages": ["reference/componentes"]
                    }
                ]
            },
            {
                "tab": "API reference",
                "openapi": true,
                "groups": [
                    {
                        "group": "Sobre a API",
                        "pages": ["reference/errors", "reference/state-lifecycles"]
                    }
                ]
            }
        ],
        "global": {
            "anchors": [
                {
                    "anchor": "Repositório",
                    "href": "https://github.com/he4rt/sycorax",
                    "icon": "github"
                }
            ]
        }
    }
}
